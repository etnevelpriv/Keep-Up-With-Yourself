rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isStringInRange(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function isNonWhitespaceStringInRange(value, minLength, maxLength) {
      return isStringInRange(value, minLength, maxLength)
        && value.matches('.*\\S.*');
    }

    function isValidEmail(value) {
      return value is string
        && value.size() > 0
        && value.matches('.*@.*');
    }

    function hasValidUserFields(data) {
      return data.keys().hasOnly([
        "userID",
        "userEmail",
        "userName",
        "userCreatedAt",
        "userVerified",
        "taskTypes"
      ])
      && data.keys().hasAll([
        "userID",
        "userEmail",
        "userName",
        "userCreatedAt",
        "userVerified",
        "taskTypes"
      ]);
    }

    function hasValidTaskFields(data) {
      return data.keys().hasOnly([
        "taskName",
        "taskDesc",
        "taskDeadline",
        "taskImportance",
        "taskTypeName",
        "taskStatus",
        "taskCompletedAt",
        "taskCreatedAt",
        "taskUpdatedAt"
      ])
      && data.keys().hasAll([
        "taskName",
        "taskDesc",
        "taskDeadline",
        "taskImportance",
        "taskTypeName",
        "taskStatus",
        "taskCompletedAt",
        "taskCreatedAt",
        "taskUpdatedAt"
      ]);
    }

    function isValidTaskState(data) {
      return data.taskStatus in ["Folyamatban", "Lejárt", "Teljesített"]
        && (
          (data.taskStatus == "Teljesített" && data.taskCompletedAt is timestamp)
          || (data.taskStatus != "Teljesített" && data.taskCompletedAt == null)
        );
    }

    function isValidTaskDocument(data) {
      return hasValidTaskFields(data)
        && isNonWhitespaceStringInRange(data.taskName, 3, 50)
        && isStringInRange(data.taskDesc, 0, 300)
        && data.taskDeadline is timestamp
        && data.taskImportance is number
        && data.taskImportance >= 1
        && data.taskImportance <= 5
        && isValidTaskType(data.taskTypeName)
        && data.taskCreatedAt is timestamp
        && data.taskUpdatedAt is timestamp
        && data.taskCreatedAt <= request.time + duration.value(5, 's')
        && data.taskDeadline >= data.taskCreatedAt
        && data.taskUpdatedAt >= data.taskCreatedAt
        && isValidTaskState(data);
    }

    function isValidUserDocument(data) {
      return hasValidUserFields(data)
        && data.userID is string
        && isValidEmail(data.userEmail)
        && isNonWhitespaceStringInRange(data.userName, 1, 30)
        && data.userCreatedAt is timestamp
        && data.userCreatedAt <= request.time + duration.value(5, 's')
        && data.userVerified is bool
        && data.userVerified == request.auth.token.email_verified
        && isValidTaskTypesList(data.taskTypes);
    }
    function isVerifiedUser(userID) {
        return request.auth != null
        && request.auth.uid == userID
        && request.auth.token.email_verified == true;
    }
    function isValidTaskType(value) {
      return value is string
        && value.size() > 1
        && value.size() <= 40
        && value.matches('^\\S(.*\\S)?$')
        && !value.matches('.*\\s{2,}.*');
    }

    function isValidTaskTypeAt(taskTypes, index) {
      return taskTypes.size() <= index || isValidTaskType(taskTypes[index]);
    }

    function isValidTaskTypesList(taskTypes) {
      return taskTypes is list
        && taskTypes.size() <= 20
        && isValidTaskTypeAt(taskTypes, 0)
        && isValidTaskTypeAt(taskTypes, 1)
        && isValidTaskTypeAt(taskTypes, 2)
        && isValidTaskTypeAt(taskTypes, 3)
        && isValidTaskTypeAt(taskTypes, 4)
        && isValidTaskTypeAt(taskTypes, 5)
        && isValidTaskTypeAt(taskTypes, 6)
        && isValidTaskTypeAt(taskTypes, 7)
        && isValidTaskTypeAt(taskTypes, 8)
        && isValidTaskTypeAt(taskTypes, 9)
        && isValidTaskTypeAt(taskTypes, 10)
        && isValidTaskTypeAt(taskTypes, 11)
        && isValidTaskTypeAt(taskTypes, 12)
        && isValidTaskTypeAt(taskTypes, 13)
        && isValidTaskTypeAt(taskTypes, 14)
        && isValidTaskTypeAt(taskTypes, 15)
        && isValidTaskTypeAt(taskTypes, 16)
        && isValidTaskTypeAt(taskTypes, 17)
        && isValidTaskTypeAt(taskTypes, 18)
        && isValidTaskTypeAt(taskTypes, 19);
    }
    match /users/{userID} {

      allow create: if request.auth != null
        && request.auth.uid == userID
        && isValidUserDocument(request.resource.data)
        && request.resource.data.userID == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.userVerified == request.auth.token.email_verified;
      allow read: if isVerifiedUser(userID);

      allow update: if isVerifiedUser(userID)
        && isValidUserDocument(request.resource.data)
        && request.resource.data.userID == resource.data.userID
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.userCreatedAt == resource.data.userCreatedAt
        && request.resource.data.userVerified == request.auth.token.email_verified;

      allow delete: if false;
      }

    match /users/{userID}/tasks/{taskID} {

      allow create: if isVerifiedUser(userID)
        && isValidTaskDocument(request.resource.data);

      allow update: if isVerifiedUser(userID)
        && isValidTaskDocument(request.resource.data)
        && request.resource.data.taskCreatedAt == resource.data.taskCreatedAt;

      allow read: if isVerifiedUser(userID);

      allow delete: if isVerifiedUser(userID);
    }
  }
}